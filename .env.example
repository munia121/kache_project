# ==========================================
# Server & Environment Configuration
# ==========================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ==========================================
# Database Connections
# ==========================================
PRISMA_DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db
MONGODB_DATABASE_URL=mongodb://localhost:27017/ecommerce_db

# PostgreSQL Configuration (Direct connection)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=ecommerce_db

# ==========================================
# Redis Cache
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# SMTP / Mailer Configuration
# ==========================================
# --- OPTION 1: Mailtrap (Development/Testing - Fake Inbox) ---
# Sign up at https://mailtrap.io -> Inboxes -> SMTP Settings -> Show Credentials
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_username
# SMTP_PASS=your_mailtrap_password
# SMTP_FROM="কাছে (Kache)" <no-reply@kache.com>

# --- OPTION 2: Gmail SMTP (Sends REAL emails directly to inboxes) ---
# 1. Enable 2-Step Verification in Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App password (16 characters)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="কাছে (Kache)" <your_email@gmail.com>

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="কাছে (Kache)" <no-reply@kache.com>

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key
JWT_REFRESH_EXPIRES_IN=30d
